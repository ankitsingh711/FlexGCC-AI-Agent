{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Reviews": "Data Source=reviews.db"
  },
  "Agent": {
    "Provider": "gemini",
    "Model": "",
    "BaseUrl": "",
    "Effort": "high",
    "MaxTokensPerTurn": 16000,
    "MaxTurns": 12,
    "MaxToolCalls": 30,
    "MaxSubmitRetries": 2,
    "MaxDiffChars": 400000,
    "InlineDiffChars": 60000,
    "MaxReadFileLines": 400,
    "EnableServerSideFallback": true,
    "TimeoutSeconds": 300
  },
  "Samples": {
    "Path": "../../../samples"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "RateLimit": {
    "ReviewsPerMinute": 10
  }
}
