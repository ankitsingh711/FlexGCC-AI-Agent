+
+    public async Task<RefundResult> RefundAsync(int invoiceId, decimal amount)
+    {
+        var invoice = await _db.Invoices.FindAsync(invoiceId);
+        if (amount > invoice.Total)
+        {
+            throw new InvalidOperationException("Refund exceeds invoice total");
+        }
+
+        invoice.Total -= amount;
+        invoice.RefundedAt = DateTime.Now;
+        RecentlyRefunded.Add(invoiceId);
+        await _db.SaveChangesAsync();
+
+        SendRefundEmail(invoice);
+        return new RefundResult(invoice.Id, invoice.Total);
+    }
+
+    private async void SendRefundEmail(Invoice invoice)
+    {
+        await _email.SendAsync(invoice.CustomerEmail, "Refund processed", $"We refunded your invoice {invoice.Id}.");
+    }
 }
