+    [AllowAnonymous]
+    [HttpPost("{id:int}/refund")]
+    public IActionResult Refund(int id, [FromBody] RefundRequest request)
+    {
+        try
+        {
+            var result = _invoices.RefundAsync(id, request.Amount).Result;
+            return Ok(result);
+        }
+        catch (Exception)
+        {
+            return Ok();
+        }
+    }
 }
+
+public record RefundRequest(decimal Amount);
